<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>top.redjujubetree</groupId>
    <artifactId>service-bridge-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>ServiceBridge</name>
    <description>Database-backed asynchronous request/response bridge with selectable MQ transport</description>
    <url>https://github.com/redjujubetree/service-bridge</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>kenny</id>
            <name>Kenny</name>
            <email>redjujubetree@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/redjujubetree/service-bridge.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/redjujubetree/service-bridge.git</developerConnection>
        <url>https://github.com/redjujubetree/service-bridge</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>bridge-protocol</module>
        <module>bridge-mq</module>
        <module>bridge-client-starter</module>
        <module>bridge-server-starter</module>
        <module>example</module>
    </modules>

    <properties>
        <revision>0.2.1</revision>
        <java.version>1.8</java.version>
        <maven.compiler.release>8</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <bedrockmq.version>0.1.0</bedrockmq.version>
        <rocketmq.version>4.9.8</rocketmq.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>top.redjujubetree</groupId>
                <artifactId>bridge-mq</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>top.redjujubetree</groupId>
                <artifactId>bridge-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>top.redjujubetree</groupId>
                <artifactId>bridge-client-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>top.redjujubetree</groupId>
                <artifactId>bridge-server-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>top.redjujubetree</groupId>
                <artifactId>bedrockmq-spring-boot-starter</artifactId>
                <version>${bedrockmq.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>8</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <bestPractices>false</bestPractices>
                            <passphraseServerId>gpg.passphrase</passphraseServerId>
                            <keyname>1DFED124E811541E2F4419EF1F6ED2EF25B79617</keyname>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                            <excludeArtifacts>
                                <excludeArtifact>service-bridge-example</excludeArtifact>
                                <excludeArtifact>service-bridge-example-client</excludeArtifact>
                                <excludeArtifact>service-bridge-example-server</excludeArtifact>
                                <excludeArtifact>service-bridge-example-monitor</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
